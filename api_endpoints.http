# ==============================================================================
# 01. TENANT DISCOVERY & DIAGNOSTICS (Public & Semi-Public)
# ==============================================================================

### 1. Resolve Tenants by Email (Central discovery route)
POST {{baseUrl}}/api/v1/auth/resolve-tenants
Accept: application/json
Content-Type: application/json

{
  "email": "john.miller@alphavet.com"
}

### 2. Tenant Diagnostic & Connection Info
GET {{baseUrl}}/api/tenant/info
Accept: application/json
X-Tenant-ID: {{tenantId}}

# ==============================================================================
# 02. AUTHENTICATION & SECURITY
# ==============================================================================

### 3. Login (Generates Sanctum Token)
# @name loginRequest
POST {{baseUrl}}/api/v1/auth/login
Accept: application/json
X-Tenant-ID: {{tenantId}}
Content-Type: application/json

{
  "email": "john.miller@alphavet.com",
  "password": "password123",
  "device_name": "HTTP Client Runner"
}

### 4. Current User Profile (Me)
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}

### 5. Verify PIN (Witness Dual-Authorization for Controlled Substances)
POST {{baseUrl}}/api/v1/auth/verify-pin
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "witness_email": "john.miller@alphavet.com",
  "pin": "1234"
}

### 6. Logout
POST {{baseUrl}}/api/v1/auth/logout
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}

# ==============================================================================
# 03. STAFF & VETERINARIAN MANAGEMENT
# ==============================================================================

### 7. List Staff Members
GET {{baseUrl}}/api/v1/staff
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}

### 8. Create New Staff Member
POST {{baseUrl}}/api/v1/staff
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Dr. Clara Oswald",
  "email": "clara.oswald.test@alphavet.com",
  "password": "password123",
  "role": "doctor",
  "phone": "+1-555-0391",
  "pin": "5678",
  "job_title" : "Senior Emergency Veterinarian",
  "specialty": "Critical Care",
  "license_number": "VET-CC-8821",
  "is_available": true
}

### 9. Get Staff Member Details
GET {{baseUrl}}/api/v1/staff/{{staffId}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}

### 10. Update Staff Member
PUT {{baseUrl}}/api/v1/staff/{{staffId}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Dr. Sarah Connor Updated",
  "email": "sarah.connor@vetservices.com",
  "role": "field_doctor",
  "phone": "+1-555-9999",
  "job_title": "Lead Ambulatory Clinician",
  "specialty": "Equine & Herd Health",
  "license_number": "VET-US-9902",
  "is_available": true
}

### 11. Update Staff Availability
PATCH {{baseUrl}}/api/v1/staff/{{staffId}}/availability
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_available": true
}

### 12. Update Staff Status (Active / Suspended)
PATCH {{baseUrl}}/api/v1/staff/{{staffId}}/status
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true
}

### 13. Delete / Archive Staff Member
DELETE {{baseUrl}}/api/v1/staff/{{staffId}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{token}}

